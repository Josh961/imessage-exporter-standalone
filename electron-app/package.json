{
  "name": "imessage-exporter-standalone",
  "version": "4.0.1",
  "description": "Export your iMessage chats to backup files",
  "author": "My Forever Books",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "vite build",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --tsconfig tsconfig.json --react-plugin --jsx-a11y-plugin --vitest-plugin --import-plugin --node-plugin && tsc --noEmit",
    "lint:fix": "oxlint . --tsconfig tsconfig.json --react-plugin --jsx-a11y-plugin --vitest-plugin --import-plugin --node-plugin --fix",
    "react:doctor": "npx --yes react-doctor@latest . --yes --no-score --blocking error",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run cli:check && npm run check-exporter-resources && npm run react:doctor && npm run test && npm run build",
    "package": "npm run build-exporter-current && npm run check-exporter-resources && npm run build && electron-builder build",
    "package:mac": "npm run build-exporter-mac && npm run check-exporter-resources && npm run build && electron-builder build --mac --arm64 && node -e \"const fs=require('fs'),f='dist-build/imessage-exporter';fs.renameSync(f+'.dmg',f+'-arm64.tmp.dmg');fs.rmSync(f+'.dmg.blockmap',{force:true})\" && electron-builder build --mac --x64 && node -e \"const fs=require('fs'),f='dist-build/imessage-exporter';fs.renameSync(f+'.dmg',f+'-x86.dmg');fs.renameSync(f+'-arm64.tmp.dmg',f+'.dmg');fs.rmSync(f+'.dmg.blockmap',{force:true})\"",
    "package:mac:dir": "npm run build-exporter-mac && npm run check-exporter-resources && npm run build && electron-builder build --mac --arm64 --dir -c.mac.identity=null -c.mac.notarize=false",
    "package:win": "npm run build-exporter-win && npm run check-exporter-resources && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder build --win",
    "postinstall": "electron-builder install-app-deps",
    "build-exporter-current": "node scripts/build-exporter-current.js",
    "build-exporter-win": "node scripts/build-exporter-win.js",
    "build-exporter-mac": "node scripts/build-exporter-mac.js",
    "check-exporter-resources": "node scripts/check-exporter-resources.js",
    "cli:check": "node ../scripts/check-cli-contract.mjs",
    "cli:sync": "node ../scripts/sync-upstream-cli.mjs",
    "cli:refresh-patch": "node ../scripts/cli-sync/create-electron-contract-patch.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "electron-store": "^10.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.imessageexporter.standalone",
    "productName": "iMessage Exporter",
    "files": [
      "dist/**/*",
      "src/main.mjs",
      "src/preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "directories": {
      "output": "dist-build"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": true,
      "binaries": [
        "Contents/Resources/imessage-exporter-mac-arm64",
        "Contents/Resources/imessage-exporter-mac-x64"
      ]
    },
    "dmg": {
      "artifactName": "imessage-exporter.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "extraFiles": [
        {
          "from": "resources/ImageMagick-7.1.1-35-Q16-HDRI-x64-dll.exe",
          "to": "ImageMagick-installer.exe"
        }
      ]
    },
    "nsis": {
      "artifactName": "imessage-exporter.${ext}",
      "include": "installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  }
}
